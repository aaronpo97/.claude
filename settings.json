{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "defaultShell": "bash",
  "disableRemoteControl": true,
  "permissions": {
    "allow": [
      "Bash(git add:*)"
    ],
    "ask": [
      "Bash(gh pr create:*)",
      "Bash(git commit:*)"
    ],
    "defaultMode": "manual"
  }
}
